; Titan Virtual Display Studio - explicit, file-handle-owned indirect monitor.
[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Provider%
CatalogFile=TitanVirtualDisplay.cat
DriverVer=10/25/2026,0.1.1.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...19041,NTamd64.10.0...22000

[Models.NTamd64.10.0...19041]
%Device%=DisplayWin10,ROOT\TitanVirtualDisplay

[Models.NTamd64.10.0...22000]
%Device%=DisplayWin11,ROOT\TitanVirtualDisplay

[SourceDisksNames]
1=%Disk%
[SourceDisksFiles]
TitanVirtualDisplay.dll=1
[DestinationDirs]
DriverFiles=13
[DriverFiles]
TitanVirtualDisplay.dll

[DisplayWin10.NT]
CopyFiles=DriverFiles
[DisplayWin10.NT.HW]
AddReg=HardwareSettings
[DisplayWin10.NT.Services]
AddService=WUDFRd,0x000001fa,ReflectorService
[ReflectorService]
DisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys
[DisplayWin10.NT.Wdf]
UmdfService=TitanVirtualDisplay,DriverInstall
UmdfServiceOrder=TitanVirtualDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[DisplayWin11.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverFiles
[DisplayWin11.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=HardwareSettings
[HardwareSettings]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0,"TitanVirtualDisplayIsolated"
HKR,,Security,0,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"
HKR,,DeviceCharacteristics,0x00010001,0x00000100
[DisplayWin11.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services
[DisplayWin11.NT.Wdf]
UmdfService=TitanVirtualDisplay,DriverInstall
UmdfServiceOrder=TitanVirtualDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients
[DriverInstall]
UmdfLibraryVersion=2.25.0
ServiceBinary=%13%\TitanVirtualDisplay.dll
UmdfExtensions=IddCx0102
[Strings]
Provider="Titanfyre"
Device="Titan Virtual Display Studio"
Disk="Titan Virtual Display Studio installation media"
